; Engine configuration file.
; Generic COIN engine + Cuba Libre module.

config_version=5

[application]

config/name="All Bridges Burning — Digital"
config/description="Motore generico per la serie COIN di GMT. Modulo attivo: All Bridges Burning."
config/game_id="all_bridges_burning"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameRegistry="*res://coin_engine/GameRegistry.gd"
GameController="*res://scenes/GameController.gd"

[display]

window/size/viewport_width=1500
window/size/viewport_height=820
window/stretch/mode="canvas_items"

[debug]

gdscript/warnings/unused_parameter=0

[rendering]

; Necessario per esportare l'app macOS universale (Intel + Apple Silicon).
textures/vram_compression/import_etc2_astc=true
